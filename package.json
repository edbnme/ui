{
  "name": "@edbn/ui",
  "version": "0.3.0",
  "description": "Locally owned shadcn components built with Base UI.",
  "author": "edbnme",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "tailwindcss",
    "accessibility",
    "a11y",
    "base-ui",
    "shadcn",
    "design-system"
  ],
  "homepage": "https://ui.edbn.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/edbnme/ui.edbn.me"
  },
  "type": "module",
  "scripts": {
    "build": "npm run registry:validate && npm run typecheck",
    "registry:build": "shadcn build registry.json --output public/r",
    "registry:validate": "shadcn registry validate registry.json && node scripts/check-registry.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "shadcn": "4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.14"
  }
}
